Options -MultiViews
RewriteEngine On
RewriteBase /

# Let Apache serve existing files and directories (including Vite assets).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send application routes to the single-page app entry point.
RewriteRule ^ index.html [L]
