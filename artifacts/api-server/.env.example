# Copy this to .env in the private app root and replace all placeholders.
# Never commit .env or place it under public/.
STATIC_DIR=public
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=admin_linkups
MYSQL_USER=your_database_user
MYSQL_PASSWORD=replace-in-directadmin-environment-settings

ADMIN_EMAIL=info@linkupsadventures.co.ke
ADMIN_EMAIL_ALIASES=info@linkpusdaventures.co.ke
ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
ADMIN_NAME=LinkUps Admin
SESSION_SECRET=generate-a-long-random-value
