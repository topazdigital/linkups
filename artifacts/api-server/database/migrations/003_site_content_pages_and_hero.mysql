-- Apply once to an existing LinkUps database if site_content does not yet have
-- hero_images and hero_mode. Fresh databases include these fields in schema.mysql.
ALTER TABLE site_content
  ADD COLUMN hero_images JSON NULL AFTER hero_image_url;
ALTER TABLE site_content
  ADD COLUMN hero_mode ENUM('static','slideshow') NOT NULL DEFAULT 'static' AFTER hero_images;

UPDATE site_content
SET hero_images = JSON_ARRAY(hero_image_url)
WHERE hero_image_url IS NOT NULL AND hero_images IS NULL;

INSERT IGNORE INTO site_content
  (page_key, page_title, hero_title, hero_subtitle, seo_description, is_published)
