-- LinkUps trip catalogue from the supplied itineraries.
-- Safe to re-run: matching slugs are refreshed; unrelated records are retained.

INSERT INTO destinations (name, slug, summary, image_url, is_featured, is_published) VALUES
  ('Maasai Mara', 'maasai-mara', 'Wildlife, game drives and wide-open savannah.', '/images/adventure-hero.png', TRUE, TRUE),
  ('Mombasa', 'mombasa', 'Coastline, warm water and time to unwind.', '/images/adventure-coast.png', TRUE, TRUE),
  ('Naivasha', 'naivasha', 'Lakeside escapes, hiking and outdoor activities.', '/images/adventure-mountain.png', TRUE, TRUE),
  ('Samburu', 'samburu', 'Northern Kenya wildlife and local culture.', '/images/adventure-hero.png', TRUE, TRUE),
  ('Amboseli', 'amboseli', 'Elephants, open plains and views toward Mount Kilimanjaro.', '/images/adventure-mountain.png', TRUE, TRUE),
  ('Watamu', 'watamu', 'Marine life, sandbanks and Kenya’s Indian Ocean coast.', '/images/adventure-coast.png', TRUE, TRUE),
  ('Sagana', 'sagana', 'White-water rafting and outdoor activities on the Tana River.', '/images/adventure-mountain.png', FALSE, TRUE),
  ('Kijabe', 'kijabe', 'Paragliding and Great Rift Valley scenery.', '/images/adventure-mountain.png', FALSE, TRUE)
ON DUPLICATE KEY UPDATE
  name = VALUES(name),
  summary = VALUES(summary),
  image_url = VALUES(image_url),
  is_published = VALUES(is_published);

INSERT INTO adventures
  (destination_id, title, slug, category, duration_days, duration_nights,
   price, price_usd, pricing_note, description, tagline, accommodation,
   highlights, itinerary, included, excluded, optional_activities, ideal_for,
   hero_image_url, gallery_image_urls, is_featured, is_published)
VALUES
  ((SELECT id FROM destinations WHERE slug = 'mombasa'), 'Coast Unleashed: The Mombasa Adventure', 'coast-unleashed', 'Beach escape', 3, 2, 25000, 350,
   'Breakfast and dinner are subject to final half-board confirmation.',
   'A three-day coastal escape at Sun N Sand Beach Resort with beach time, resort leisure, group games and optional coastal exploration.',
   'Chase the waves. Feel the thrill. Live the adventure!', 'Sun N Sand Beach Resort',
   JSON_ARRAY('Return SGR economy tickets from Nairobi', 'Beach and pool leisure', 'Mombasa heritage and coastal exploration', 'Group bonding activities and LinkUps games'),
   JSON_ARRAY(
     JSON_OBJECT('day', 'Day 1', 'title', 'The Coast Takeover', 'details', JSON_ARRAY('Travel from Nairobi by SGR, flight or arranged road transport.', 'Transfer to Sun N Sand and check in, subject to the hotel check-in time.', 'Lunch and leisure time at the resort, with swimming and beach walks.', 'Evening welcome mixer, icebreakers, LinkUps games and dinner.')),
     JSON_OBJECT('day', 'Day 2', 'title', 'Explore, Splash & Unleash', 'details', JSON_ARRAY('Breakfast at the hotel.', 'Optional guided Fort Jesus and Mombasa Old Town visit.', 'Coastal exploration, resort swimming and group challenges.', 'Sunset photos, dinner and optional adult nightlife experience.')),
     JSON_OBJECT('day', 'Day 3', 'title', 'One Last Splash', 'details', JSON_ARRAY('Breakfast and a final swim if time permits.', 'Group photos and a short LinkUps adventure recap.', 'Check out and transfer to the SGR station, airport or return road journey.'))
   ),
   JSON_ARRAY('Two nights accommodation on a sharing basis', 'Breakfast and dinner, subject to final half-board confirmation', 'Return SGR economy tickets from Nairobi', 'Return transfers between Mombasa SGR station and the resort', 'LinkUps Adventures trip coordination', 'Group bonding activities and scheduled resort leisure time'),
   JSON_ARRAY('Optional excursions and water sports', 'Special dinner experiences and nightlife', 'Personal purchases and expenses', 'Anything not listed in the confirmed quotation'),
   JSON_ARRAY('Fort Jesus and Old Town excursion', 'Boat rides and water sports, subject to availability', 'Special dinner experiences and nightlife', 'Other coastal excursions chosen by the group'),
   JSON_ARRAY('Friends', 'Couples', 'Solo travellers', 'Adventure groups'),
   '/images/trips/coast-unleashed.jpg', JSON_ARRAY(), TRUE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'watamu'), 'Watamu Blue Bliss: Safari Blue Experience', 'watamu-blue-bliss', 'Ocean adventure', 1, 0, 5500, 90,
   'Boat routes and finish time depend on tides, weather and sea conditions.',
   'A full-day Watamu ocean trip with a dhow cruise, snorkelling, a sandbank stop and a fresh Swahili seafood lunch.',
   'Turquoise waters, sandbanks and a taste of the coast.', NULL,
   JSON_ARRAY('Scenic dhow or excursion-boat cruise', 'Snorkelling and marine exploration where conditions allow', 'Sandbank stop subject to tides', 'Seafood or Swahili lunch', 'Cultural tour, seasonal dolphin watching and mangrove tour'),
   JSON_ARRAY(JSON_OBJECT('day', 'Full day', 'title', 'Sail, snorkel and unwind', 'details', JSON_ARRAY('7:30–8:30 AM — Meet the crew, check in, receive a safety briefing and board.', '8:30–10:00 AM — Cruise coastal waters and explore the agreed marine route.', '10:00 AM–12:00 PM — Snorkel and explore the reef when permitted and safe.', '12:00–1:00 PM — Visit a sandbank when tides and weather permit.', '1:00–2:30 PM — Enjoy a Swahili seafood lunch; request vegetarian food in advance.', '2:30–3:30 PM — Leisure cruise and return to the departure point.'))),
   JSON_ARRAY('Full-day boat excursion with captain and crew', 'Snorkelling equipment and guided reef exploration where conditions allow', 'Sandbank stop, subject to tides', 'Seafood or Swahili lunch', 'Drinking water', 'Basic safety briefing and life jackets', 'Cultural tour and entertainment', 'Dolphin watching during the season', 'Mangrove tour'),
   JSON_ARRAY('Marine park fees', 'Transport from Nairobi or other towns', 'Watamu hotel transfers', 'Alcoholic drinks, tips and personal purchases', 'Optional activities outside the agreed itinerary'),
   JSON_ARRAY(),
   JSON_ARRAY('Couples', 'Friends', 'Families', 'International visitors'),
   '/images/trips/watamu-blue-bliss.jpg', JSON_ARRAY(), TRUE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'amboseli'), 'Kilimanjaro Sky Escape: Amboseli Balloon Safari', 'kilimanjaro-sky-escape', 'Balloon safari', 1, 0, 0, NULL,
   'Rates and availability are confirmed on enquiry. Balloon flights are weather-dependent.',
   'A sunrise hot-air balloon flight over the Amboseli landscape, with views toward Mount Kilimanjaro and the plains below.',
   'Let the skies become your next adventure.', NULL,
   JSON_ARRAY('Shared or private flight arrangements on request', 'Sunrise views across the Amboseli landscape', 'Advance booking required', 'Launch site and flight route depend on the operator and wind conditions'),
   JSON_ARRAY(JSON_OBJECT('day', 'Early morning', 'title', 'Sunrise balloon experience', 'details', JSON_ARRAY('Around 4:30–5:15 AM — Pickup from participating accommodation.', 'Around 5:15 AM — Check in and receive the pre-flight briefing.', 'Around sunrise — Balloon flight of approximately 45–90 minutes, subject to conditions.', 'After landing — Breakfast and a celebratory moment, depending on the operator.', 'Morning — Return transfer and optional continuation of the day’s game drive.'))),
   JSON_ARRAY('Shared hot-air balloon flight with a qualified pilot', 'Pre-flight briefing and ground crew support', 'Transfers to launch and landing areas where included by the supplier', 'Bush breakfast and celebratory drink where included', 'LinkUps Adventures booking assistance'),
   JSON_ARRAY('Accommodation and transport from Nairobi', 'Park entry fees and applicable levies', 'Extra meals, drinks and personal expenses', 'Tips and optional private hire or photography'),
   JSON_ARRAY('Private balloon hire', 'Photography add-ons'),
   JSON_ARRAY('Couples', 'Friends', 'Honeymooners', 'Photographers', 'Wildlife lovers'),
   '/images/trips/kilimanjaro-sky-escape.jpg', JSON_ARRAY(), TRUE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'amboseli'), 'Amboseli Wild Dash: 1-Day Safari', 'amboseli-wild-dash', 'Safari', 1, 0, 6500, 80,
   'Park entry fees are not included.',
   'A full-day safari from Nairobi with a game drive across Amboseli and a chance to see elephants, zebras, giraffes and other wildlife.',
   'A big safari adventure packed into one unforgettable day.', NULL,
   JSON_ARRAY('Nairobi departure and return', 'Safari game drive in a suitable vehicle', 'Picnic stop at a designated area', 'Wildlife viewing and photography'),
   JSON_ARRAY(JSON_OBJECT('day', 'Day 1', 'title', 'A full day in Amboseli', 'details', JSON_ARRAY('4:30 AM — Pick-up and departure from Nairobi.', '7:30 AM — Arrive in the Amboseli area and complete park entry formalities.', '8:00 AM–12:00 PM — Morning game drive.', '12:00–1:00 PM — Picnic lunch at a designated area.', '1:00–3:00 PM — Continue the safari and enjoy scenic photography stops where permitted.', '3:00–4:00 PM — Exit the park and begin the return journey.', '7:00–8:00 PM — Estimated arrival in Nairobi, depending on road conditions.'))),
   JSON_ARRAY('Return transport from Nairobi', 'Amboseli game drive in a suitable safari vehicle', 'Professional driver-guide', 'LinkUps Adventures trip coordination'),
   JSON_ARRAY('Park entry fees', 'Picnic lunch and drinks', 'Tips and gratuities', 'Anything not listed in the confirmed quotation'),
   JSON_ARRAY(),
   JSON_ARRAY('Friends', 'Couples', 'Families', 'Day-trip travellers'),
   '/images/trips/amboseli-wild-dash.jpg', JSON_ARRAY(), TRUE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'maasai-mara'), 'Mara Sky Escape: Hot-Air Balloon Safari', 'mara-sky-escape', 'Balloon safari', 1, 0, 0, NULL,
   'Rates and availability are confirmed on enquiry. Flights are weather-dependent and require advance booking.',
   'A sunrise balloon flight over the Mara’s sweeping plains and winding rivers, followed by a celebratory bush breakfast.',
   'See the Mara wake up from above.', NULL,
   JSON_ARRAY('Sunrise flight over the Maasai Mara', 'Approximately one hour in the air, weather permitting', 'Shared and private arrangements on request', 'Flight route and supplier inclusions vary'),
   JSON_ARRAY(JSON_OBJECT('day', 'Early morning', 'title', 'Sunrise over the Mara', 'details', JSON_ARRAY('4:30–5:30 AM — Pickup from the participating camp or lodge.', 'Before sunrise — Transfer to the launch site and safety briefing.', 'Sunrise — Approximately one hour in the air, weather permitting.', 'After landing — Celebratory drink and bush breakfast, as provided by the operator.', 'Morning — Return transfer, potentially combined with a game drive.'))),
   JSON_ARRAY('Shared hot-air balloon flight with a qualified pilot', 'Pre-flight briefing and ground crew support', 'Transfers to launch and landing areas where included by the supplier', 'Bush breakfast and celebratory drink where included', 'LinkUps Adventures booking assistance'),
   JSON_ARRAY('Accommodation and transport from Nairobi', 'Park entry fees and applicable levies', 'Extra meals, drinks and personal expenses', 'Tips and optional private hire or photography'),
   JSON_ARRAY('Private balloon hire', 'Photography add-ons'),
   JSON_ARRAY('Couples', 'Friends', 'Honeymooners', 'Photographers', 'Wildlife lovers'),
   '/images/trips/mara-sky-escape.jpg', JSON_ARRAY(), TRUE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'samburu'), 'Samburu Overland Experience Road Trip', 'samburu-overland', 'Safari & camping', 2, 1, 15500, 200,
   'Park entry fees and lunches are excluded.',
   'A two-day overland road trip with a Samburu game drive, camping, a Buffalo Springs swim, Mt. Ololokwe views and a bonfire night.',
   'Adventure, camping, wildlife, culture and fun.', 'One night camping',
   JSON_ARRAY('Scenic overland road trip from Nairobi', 'Samburu game drive and Buffalo Springs swim', 'Bonfire, music, storytelling and stargazing', 'Visit to Mt. Ololokwe', 'Half-board meals'),
   JSON_ARRAY(
     JSON_OBJECT('day', 'Day 1', 'title', 'Nairobi to Samburu', 'details', JSON_ARRAY('Early departure from Nairobi with comfort stops.', 'Arrive in Samburu and check in at camp.', 'Afternoon game drive and Buffalo Springs visit.', 'Return to camp for dinner, bonfire, games and overnight camping.')),
     JSON_OBJECT('day', 'Day 2', 'title', 'Mt. Ololokwe and return', 'details', JSON_ARRAY('Sunrise and breakfast.', 'Visit Mt. Ololokwe for sightseeing, photography and nature appreciation.', 'Group games, check out and begin the journey back to Nairobi.', 'Scenic stopovers and evening arrival in Nairobi.'))
   ),
   JSON_ARRAY('Transport in an overland tour vehicle', 'One night camping accommodation', 'Half-board dinner and breakfast', 'Samburu game drive', 'Buffalo Springs swimming experience', 'Mt. Ololokwe visit, bonfire, games and entertainment', 'Trip host'),
   JSON_ARRAY('Lunches', 'Park entry fees', 'Personal expenses, drinks and snacks', 'Anything not listed in the confirmed quotation'),
   JSON_ARRAY(),
   JSON_ARRAY('Friends', 'Solo travellers', 'Couples', 'Corporate groups', 'Adventure lovers'),
   '/images/trips/samburu-overland.jpg', JSON_ARRAY(), TRUE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'sagana'), 'Rapids & Rush: White-Water Rafting', 'rapids-and-rush', 'Outdoor adventure', 1, 0, 0, NULL,
   'Confirm current package price and activity availability with LinkUps Adventures.',
   'A Tana River rafting day with professional river guides, safety equipment, lunch and the option to add more activities.',
   'Your crew. Your courage. Your adventure.', NULL,
   JSON_ARRAY('White-water rafting with professional guides', 'Road trip from Nairobi', 'Lunch and time to relax by the river', 'Optional extra activities at the selected camp'),
   JSON_ARRAY(JSON_OBJECT('day', 'Day 1', 'title', 'Sagana river adventure', 'details', JSON_ARRAY('6:00 AM — Depart Nairobi for Sagana.', '9:00 AM — Meet the rafting guides, receive safety gear and learn paddle commands.', '10:00 AM — Raft the Tana River; route and duration depend on river conditions.', '1:30 PM — Lunch, river views and relaxation.', '2:30 PM — Optional activities at extra cost.', '4:00 PM — Depart for Nairobi.'))),
   JSON_ARRAY('Return transport from Nairobi', 'White-water rafting activity', 'Required safety equipment and professional guides', 'Lunch and drinking water', 'LinkUps Adventures trip coordination'),
   JSON_ARRAY('Ziplining, kayaking and other optional activities', 'Personal purchases and tips', 'Personal travel insurance', 'Accommodation or additional meals'),
   JSON_ARRAY('Kayaking', 'Ziplining', 'Rock climbing'),
   JSON_ARRAY('Friends', 'Couples', 'Birthday groups', 'Thrill-seekers'),
   '/images/trips/rapids-and-rush.jpg', JSON_ARRAY(), FALSE, TRUE),
  (NULL, 'Sky Safari Balloon Experiences', 'sky-safari-balloon-experience', 'Balloon safari', 1, 0, 0, NULL,
   'Rates, availability and operator inclusions are confirmed on enquiry.',
   'Choose a sunrise balloon adventure over the Maasai Mara or Amboseli, with shared and private arrangements available on request.',
   'Rise above the ordinary with LinkUps Adventures.', NULL,
   JSON_ARRAY('Mara Sky Escape over the Maasai Mara', 'Kilimanjaro Sky Escape over the Amboseli landscape', 'Shared and private arrangements on request', 'Advance booking required; flights are weather-dependent'),
   JSON_ARRAY(JSON_OBJECT('day', 'Sunrise', 'title', 'Choose your sky safari', 'details', JSON_ARRAY('Select a Maasai Mara or Amboseli balloon experience.', 'The operator confirms pickup time, launch point, flight route and package inclusions.', 'Complete the pre-flight briefing and enjoy the sunrise flight, weather permitting.', 'Breakfast and return transfer depend on the selected operator.'))),
   JSON_ARRAY('Flight and operator inclusions as confirmed in the selected quotation', 'LinkUps Adventures booking assistance'),
   JSON_ARRAY('Accommodation and transport from Nairobi', 'Park entry fees and applicable levies unless stated in the quote', 'Any items not listed in the selected operator’s quotation'),
   JSON_ARRAY('Private balloon hire', 'Photography add-ons'),
   JSON_ARRAY('Couples', 'Friends', 'Honeymooners', 'Photographers', 'Wildlife lovers'),
   '/images/trips/sky-safari-collection.jpg', JSON_ARRAY(), FALSE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'kijabe'), 'SkyHigh Escape: Tandem Paragliding', 'skyhigh-paragliding-escape', 'Air adventure', 1, 0, 32500, NULL,
   'Dates depend on flight availability and suitable weather. Advance booking is essential.',
   'A tandem paragliding flight above the Great Rift Valley with a professional pilot, shared transport from Nairobi and GoPro footage.',
   'Feel the freedom. Chase the thrill.', NULL,
   JSON_ARRAY('Tandem flight with a professional pilot', 'Great Rift Valley views', 'GoPro flight footage', 'Lunch and refreshments'),
   JSON_ARRAY(JSON_OBJECT('day', 'Flight day', 'title', 'Take to the skies', 'details', JSON_ARRAY('Meet the LinkUps group for the shared drive from Nairobi.', 'Arrive in Kijabe and receive the flight briefing.', 'Fly tandem with a professional pilot when conditions are suitable.', 'Enjoy lunch, refreshments and scenic photo moments before returning.'))),
   JSON_ARRAY('Tandem paragliding flight', 'Return shared transport from Nairobi', 'GoPro flight footage', 'Lunch and refreshments', 'LinkUps Adventures trip coordination'),
   JSON_ARRAY('Personal purchases', 'Travel insurance', 'Anything not listed in the confirmed quotation'),
   JSON_ARRAY(),
   JSON_ARRAY('Couples', 'Friends', 'Birthday celebrations', 'Solo adventurers', 'Thrill-seekers'),
   '/images/trips/skyhigh-paragliding.jpg', JSON_ARRAY(), FALSE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'amboseli'), 'Amboseli Wild Horizons Immersion', 'amboseli-wild-horizons-immersion', 'Safari', 3, 2, 0, NULL,
   'Price is confirmed by quotation. Park entry fees are excluded.',
   'A slower, more immersive Amboseli safari with two nights at Kibo Safari Camp, scheduled game drives and full-board meals subject to quotation.',
   'More time in the wild. More room to explore.', 'Kibo Safari Camp',
   JSON_ARRAY('Two nights at Kibo Safari Camp', 'Scheduled Amboseli game drives', 'Elephants, wetlands and panoramic landscapes', 'Professional driver-guide'),
   JSON_ARRAY(
     JSON_OBJECT('day', 'Day 1', 'title', 'The adventure begins', 'details', JSON_ARRAY('6:00 AM — Depart Nairobi.', 'Late morning — Arrive in Amboseli and begin a game drive.', 'Lunch at camp or a designated picnic site.', 'Afternoon wildlife viewing, camp check-in, dinner and stargazing.')),
     JSON_OBJECT('day', 'Day 2', 'title', 'A full day in Amboseli', 'details', JSON_ARRAY('6:00 AM — Early-morning game drive.', '9:00 AM — Return to camp for breakfast.', 'Relax at camp or arrange an optional cultural experience.', 'Afternoon game drive focused on elephants, wetlands and landscapes.', 'Dinner and leisure time at camp.')),
     JSON_OBJECT('day', 'Day 3', 'title', 'One last taste of the wild', 'details', JSON_ARRAY('Optional early-morning game drive, subject to park access arrangements.', 'Breakfast, check out and depart for Nairobi.', 'Lunch stop en route and estimated late-afternoon arrival.'))
   ),
   JSON_ARRAY('Return transport from Nairobi', 'Two nights at Kibo Safari Camp', 'Full-board meals, subject to quotation', 'Scheduled game drives', 'Professional driver-guide', 'LinkUps Adventures trip coordination'),
   JSON_ARRAY('Park entry fees', 'Maasai cultural village guided visits', 'Hot-air balloon rides', 'Special celebration setups or private photography', 'Anything not listed in the confirmed quotation'),
   JSON_ARRAY('Maasai cultural village visit', 'Hot-air balloon ride'),
   JSON_ARRAY('Wildlife lovers', 'Couples', 'Families', 'Photographers'),
   '/images/trips/amboseli-wild-horizons-3day.jpg', JSON_ARRAY(), FALSE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'naivasha'), 'Girls’ Naivasha Road Trip', 'girls-naivasha-roadtrip', 'Group escape', 1, 0, 5500, NULL,
   'Confirm current group rates and departure dates with LinkUps Adventures. The older event date in the source is not current.',
   'A Naivasha group day trip combining Lake Naivasha, a boat ride, Hell’s Gate, the Olkaria hot spa, games and photography.',
   'Good company, open roads and a day to remember.', NULL,
   JSON_ARRAY('Lake Naivasha boat ride and wildlife viewing', 'Hell’s Gate game drive', 'Olkaria natural hot-water spa and swimming', 'Matching T-shirts, group games and photography'),
   JSON_ARRAY(JSON_OBJECT('day', 'Day 1', 'title', 'Lake, gorge and hot-spring escape', 'details', JSON_ARRAY('6:00–6:30 AM — Pick-up and departure for Naivasha.', 'Stop at the Rift Valley viewpoint for the scenery.', 'Continue to Lake Naivasha for a boat trip, wildlife viewing and photos.', 'Visit Hell’s Gate National Park and the Olkaria natural hot-water spa.', 'Around 5:00 PM — Depart for Nairobi.'))),
   JSON_ARRAY('Return transport', 'Team-building activities', 'Park entry fees as confirmed in the current package', 'Tour guide', 'Swimming and boat ride', 'Drinking water'),
   JSON_ARRAY('Lunch', 'Refreshments', 'Optional tips and personal purchases'),
   JSON_ARRAY('Camel rides', 'Bikes', 'Fresh fish lunch'),
   JSON_ARRAY('Friends', 'Women’s groups', 'Birthday groups', 'Team outings'),
   '/images/trips/girls-naivasha-roadtrip.jpg', JSON_ARRAY(), FALSE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'amboseli'), 'Amboseli Wild Horizons Escape', 'amboseli-wild-horizons-escape', 'Safari', 2, 1, 0, NULL,
   'Price is confirmed by quotation. Park entry fees are not specified in the source.',
   'A one-night Amboseli safari escape based at Kibo Safari Camp, with game drives and meals on a full-board plan.',
   'One night in the wilderness. A lot to remember.', 'Kibo Safari Camp',
   JSON_ARRAY('One night at Kibo Safari Camp', 'Game drives in Amboseli', 'Sunrise wildlife viewing and possible Kilimanjaro views', 'Return road transport from Nairobi'),
   JSON_ARRAY(
     JSON_OBJECT('day', 'Day 1', 'title', 'Into the wild', 'details', JSON_ARRAY('6:00 AM — Depart Nairobi.', 'Arrive in the Amboseli area, then enter the park for a game drive.', 'Lunch at camp if timing permits, or as a picnic.', 'Afternoon wildlife viewing, camp check-in and dinner.')),
     JSON_OBJECT('day', 'Day 2', 'title', 'Sunrise safari and home', 'details', JSON_ARRAY('6:00 AM — Early-morning game drive.', '9:00 AM — Return to camp for breakfast.', '10:00–11:00 AM — Check out and depart, with an optional final safari drive.', 'Stop for lunch en route and return to Nairobi in the late afternoon or evening.'))
   ),
   JSON_ARRAY('Return road transport from Nairobi', 'One night at Kibo Safari Camp', 'Meals on a full-board meal plan', 'Game drives in Amboseli', 'Professional driver-guide', 'LinkUps Adventures coordination'),
   JSON_ARRAY('Park entry fees unless confirmed in the quotation', 'Personal expenses and tips', 'Anything not listed in the confirmed quotation'),
   JSON_ARRAY('Final game drive, subject to park entry and exit arrangements'),
   JSON_ARRAY('Couples', 'Friends', 'Families', 'Safari travellers'),
   '/images/trips/amboseli-wild-horizons-2day.jpg', JSON_ARRAY(), FALSE, TRUE),
  ((SELECT id FROM destinations WHERE slug = 'maasai-mara'), 'Maasai Mara Villa Escape', 'maasai-mara-villa-escape', 'Luxury safari', 3, 2, 40000, 500,
   'Park fees are separate: source lists KES 2,000 per resident and USD 200 per non-resident. Confirm current fees before booking.',
   'A three-day private-villa safari escape with wildlife viewing, a pool, group games, sundowners and bonfire nights under the stars.',
   'Wild luxury. Epic adventures. Unforgettable company.', 'Private villa',
   JSON_ARRAY('Two nights in a private villa', 'Scheduled game drive in a suitable safari vehicle', 'Swimming, group games and bonfire arrangements', 'Return transport from Nairobi'),
   JSON_ARRAY(
     JSON_OBJECT('day', 'Day 1', 'title', 'Arrive and settle into the Mara', 'details', JSON_ARRAY('Travel from Nairobi and check in to the private villa.', 'Enjoy the pool, group games and time to relax.', 'Dinner and an evening bonfire, subject to the final package.')),
     JSON_OBJECT('day', 'Day 2', 'title', 'Wildlife and optional experiences', 'details', JSON_ARRAY('Take the scheduled game drive in a suitable safari vehicle.', 'Choose optional activities such as a balloon safari or cultural visit.', 'Return to the villa for leisure, sundowners and group time.')),
     JSON_OBJECT('day', 'Day 3', 'title', 'One last Mara morning', 'details', JSON_ARRAY('Enjoy breakfast and a final relaxed morning.', 'Check out and return to Nairobi.'))
   ),
   JSON_ARRAY('Private villa accommodation for two nights', 'Return transport from Nairobi', 'Meals as specified in the final package', 'One scheduled game drive', 'Swimming, group games and bonfire arrangements', 'Professional trip coordination by LinkUps Adventures'),
   JSON_ARRAY('Park fees', 'Alcoholic drinks', 'Personal effects, insurance and gratuities'),
   JSON_ARRAY('Hot-air balloon safari', 'Maasai village cultural visit', 'Traditional Maasai dance experience', 'Guided nature walk', 'Bush breakfast or sundowner experience', 'Local beadwork and souvenir shopping'),
   JSON_ARRAY('Friends', 'Birthday celebrations', 'Couples', 'Content creators', 'Adventure lovers'),
   '/images/trips/maasai-mara-villa-escape.jpg', JSON_ARRAY(), TRUE, TRUE)
ON DUPLICATE KEY UPDATE
  destination_id = VALUES(destination_id),
  title = VALUES(title),
  category = VALUES(category),
  duration_days = VALUES(duration_days),
  duration_nights = VALUES(duration_nights),
  price = VALUES(price),
  price_usd = VALUES(price_usd),
  pricing_note = VALUES(pricing_note),
  description = VALUES(description),
  tagline = VALUES(tagline),
  accommodation = VALUES(accommodation),
  highlights = VALUES(highlights),
  itinerary = VALUES(itinerary),
  included = VALUES(included),
  excluded = VALUES(excluded),
  optional_activities = VALUES(optional_activities),
  ideal_for = VALUES(ideal_for),
  hero_image_url = VALUES(hero_image_url),
  gallery_image_urls = VALUES(gallery_image_urls),
  is_featured = VALUES(is_featured),
  is_published = VALUES(is_published);

-- These were placeholder sample tours in the original imported seed.
-- Keep their records (and any booking history) but remove them from the public catalogue.
UPDATE adventures
SET is_published = FALSE
WHERE slug IN ('mombasa-beach-escape', 'naivasha-adventure', 'wild-hearts-escape', 'girls-adventure-escape');
